# Server Configuration
PORT=5000

# MongoDB Configuration (Local or MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitness_db?retryWrites=true&w=majority
# If left empty, the server will operate in high-performance in-memory mock mode.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_fitness

# Google Gemini API Key
# Obtain for free from https://aistudio.google.com/
# If left empty, intelligent fallback recommendations will be served so the app works seamlessly!
GEMINI_API_KEY=
